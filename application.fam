App(
    # appid names the built artifact, so this produces meshtastic.fap.
    # The repo is meshtastic-flipper; the app on the device is just Meshtastic.
    appid="meshtastic",
    name="Meshtastic",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="meshtastic_flipper_app",
    stack_size=2 * 1024,
    # Installs to /ext/apps rather than /ext/apps/Tools. The category is what the
    # loader uses to pick the directory, and a subfolder is one more level to
    # navigate every time this is opened.
    fap_category="",
    fap_description="Meshtastic LoRa receiver. Requires an external SX1262 module.",
    fap_author="nickk02",
    fap_version="0.1",
    fap_icon="images/icon_10x10.png",
    # Listed explicitly, because the default glob also pulls in test/host,
    # which is PC-only code that has no business in the firmware build.
    sources=[
        "meshtastic_flipper.c",
        "src/*.c",
        "src/proto/*.c",
        "src/model/*.c",
        "src/radio/*.c",
        "src/ble/*.c",
        "src/ui/*.c",
    ],
    fap_private_libs=[
        # tiny-AES-c selects its modes with #ifndef guards, so configuring it
        # here keeps the vendored sources byte-identical to upstream.
        Lib(
            name="tiny-AES-c",
            fap_include_paths=["."],
            sources=["aes.c"],
            cdefines=["CBC=0", "ECB=0", "CTR=1"],
        ),
    ],
)
